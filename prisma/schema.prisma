generator client {
  provider = "prisma-client"
  output   = "../lib/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models

model User {
  id String @id @default(cuid())

  name          String
  firstName     String?
  lastName      String?
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  lastLoginAt   DateTime?

  role       String    @default("user")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  sessions   Session[]
  accounts   Account[]
  profile    Profile?
  positions   Position[]   @relation("UserPositions")
  candidates  Candidate[]  @relation("UserCandidates")
  quizzes     Quiz[]       @relation("UserQuizzes")
  questions   Question[]   @relation("UserQuestions")
  evaluations Evaluation[] @relation("UserEvaluations")
  ownedApplications   Application[] @relation("UserOwnedApplications")
  decidedApplications Application[] @relation("UserDecidedApplications")
  scorecards          Scorecard[]      @relation("UserScorecards")
  interviewGuides     InterviewGuide[] @relation("UserInterviewGuides")
  createdInterviews       Interview[]            @relation("UserCreatedInterviews")
  interviewParticipations InterviewParticipant[] @relation("UserInterviewParticipations")
  interviewerFeedback     InterviewerFeedback[]  @relation("UserInterviewerFeedback")
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  interviewProposals InterviewProposal[] @relation("InterviewProposalCreator")
  scoreOverrides     ScoreOverride[]     @relation("ScoreOverrideCreator")

  // MCP access switched off for this user by an administrator
  mcpDisabled Boolean @default(false)

  isAnonymous Boolean?

  @@unique([email])
  @@map("user")
}

model Session {
  id String @id @default(cuid())

  expiresAt      DateTime
  token          String
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@map("sessions")
}

model Account {
  id String @id @default(cuid())

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id String @id @default(cuid())

  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("verification")
}

// Better Auth OAuth provider (@better-auth/oauth-provider) and jwt plugin
// models: fields as the plugin schema of the pinned version requires

model Jwks {
  id String @id @default(cuid())

  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id String @id @default(cuid())

  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_clients")
}

model OauthResource {
  id String @id @default(cuid())

  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@unique([identifier])
  @@map("oauth_resources")
}

model OauthClientResource {
  id String @id @default(cuid())

  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthRefreshToken {
  id String @id @default(cuid())

  token                   String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  clientId  String
  client    OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId String?
  session   Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokens OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id String @id @default(cuid())

  token                   String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  clientId     String
  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId    String?
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshId    String?
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id String @id @default(cuid())

  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  clientId String
  client   OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId   String?
  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

// Single-use private_key_jwt assertion ids: the plugin always supplies the id
// (a digest of the assertion), so it has no default
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertions")
}

// App-specific models
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  userName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum PositionStatus {
  draft
  open
  closed
}

model Position {
  id              String         @id @default(cuid())
  title           String
  description     String?
  experienceLevel String
  skills          String[]
  softSkills      String[]
  contractType    String?
  status          PositionStatus @default(draft)
  createdBy       String
  createdAt       DateTime       @default(now())

  creator           User               @relation("UserPositions", fields: [createdBy], references: [id], onDelete: Cascade)
  applications      Application[]
  quizzes           Quiz[]
  evaluations       Evaluation[]
  scorecard         Scorecard?
  interviewGuides   InterviewGuide[]

  @@index([status])
  @@map("positions")
}

enum CriterionCategory {
  technical
  soft
  culture
}

enum CriterionPriority {
  must
  nice
}

enum CriterionSource {
  skill
  softSkill
  custom
}

enum GuideSectionKind {
  intro
  experience
  technical
  behavioral
  candidate_questions
  closing
}

// The evaluation scorecard ("Scheda di valutazione") of a position: at most one per position
model Scorecard {
  id         String   @id @default(cuid())
  positionId String   @unique
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  position Position             @relation(fields: [positionId], references: [id], onDelete: Cascade)
  creator  User                 @relation("UserScorecards", fields: [createdBy], references: [id], onDelete: Cascade)
  criteria ScorecardCriterion[]

  @@map("scorecards")
}

model ScorecardCriterion {
  id            String            @id @default(cuid())
  scorecardId   String
  name          String
  description   String?
  category      CriterionCategory
  priority      CriterionPriority
  weight        Int // 1-5
  expectedLevel Int // 1-5
  anchors       Json? // { weak, medium, strong }
  source        CriterionSource
  order         Int
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())

  scorecard Scorecard        @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  scores    CriterionScore[]

  @@index([scorecardId])
  @@map("scorecard_criteria")
}

// Interview guide ("Guida colloquio"): a template of the position, for example one per round
model InterviewGuide {
  id              String   @id @default(cuid())
  positionId      String
  title           String
  round           Int // 1-based order of the round
  durationMinutes Int
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  position Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  creator  User           @relation("UserInterviewGuides", fields: [createdBy], references: [id], onDelete: Cascade)
  sections   GuideSection[]
  interviews Interview[]

  @@index([positionId])
  @@map("interview_guides")
}

model GuideSection {
  id      String           @id @default(cuid())
  guideId String
  title   String
  minutes Int
  order   Int
  kind    GuideSectionKind

  guide     InterviewGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  questions GuideQuestion[]

  @@index([guideId])
  @@map("guide_sections")
}

model GuideQuestion {
  id           String   @id @default(cuid())
  sectionId    String
  text         String
  followUps    String[] @default([])
  criterionIds String[] @default([])
  anchors      Json? // { weak, medium, strong }
  required     Boolean  @default(false)
  order        Int

  section GuideSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("guide_questions")
}

model Candidate {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  // Stored normalised: lower case, no surrounding spaces
  email            String    @unique
  dateOfBirth      DateTime?
  resumeUrl        String?
  doNotContact     Boolean   @default(false)
  doNotContactNote String?
  // Null when the candidate applied through the public form
  createdBy        String?
  createdAt        DateTime  @default(now())

  applications      Application[]
  creator           User?              @relation("UserCandidates", fields: [createdBy], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  evaluations       Evaluation[]

  @@map("candidates")
}

enum ApplicationStage {
  applied
  screening
  assessment
  interview
  decision
  offer
  hired
  rejected
  withdrawn
}

// A candidacy: one Candidate for one Position
model Application {
  id                String           @id @default(cuid())
  candidateId       String
  positionId        String
  stage             ApplicationStage @default(applied)
  stageChangedAt    DateTime         @default(now())
  // The recruiter in charge; never restricts access
  ownerId           String?
  decision          String?
  decisionRationale String?
  decidedBy         String?
  decidedAt         DateTime?
  decisionWeights   Json?
  createdAt         DateTime         @default(now())

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  owner       User?        @relation("UserOwnedApplications", fields: [ownerId], references: [id], onDelete: SetNull)
  decider     User?        @relation("UserDecidedApplications", fields: [decidedBy], references: [id], onDelete: SetNull)
  assessments Assessment[]
  interviews  Interview[]
  interviewProposals InterviewProposal[]

  @@unique([candidateId, positionId])
  @@index([candidateId])
  @@index([positionId])
  @@index([stage])
  @@index([ownerId])
  @@map("applications")
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
  no_show
}

enum InterviewParticipantRole {
  lead
  observer
}

enum KitStatus {
  draft
  ready
}

enum KitItemOrigin {
  template
  cv
  resume_gap
  quiz_answer
  previous_round
  manual
}

// An interview ("Colloquio") of an application, prepared from an interview guide
model Interview {
  id              String          @id @default(cuid())
  applicationId   String
  guideId         String?
  round           Int
  scheduledAt     DateTime
  durationMinutes Int
  meetingUrl      String?
  status          InterviewStatus @default(scheduled)
  startedAt       DateTime?
  endedAt         DateTime?
  sequence        Int             @default(0) // .ics SEQUENCE, +1 on every reschedule
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application  Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  guide        InterviewGuide?        @relation(fields: [guideId], references: [id], onDelete: SetNull)
  creator      User?                  @relation("UserCreatedInterviews", fields: [createdBy], references: [id], onDelete: SetNull)
  participants InterviewParticipant[]
  kit          InterviewKit?
  feedback     InterviewerFeedback[]

  @@index([applicationId])
  @@index([status, scheduledAt])
  @@map("interviews")
}

model InterviewParticipant {
  id          String                   @id @default(cuid())
  interviewId String
  userId      String
  role        InterviewParticipantRole

  interview Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User          @relation("UserInterviewParticipations", fields: [userId], references: [id], onDelete: Cascade)
  notes     KitItemNote[]

  @@unique([interviewId, userId])
  @@index([userId])
  @@map("interview_participants")
}

// The interview kit: a snapshot of the guide, prepared for one interview
model InterviewKit {
  id             String    @id @default(cuid())
  interviewId    String    @unique
  status         KitStatus @default(draft)
  briefing       Json? // string[] (max 5 points)
  hypotheses     Json? // { criterionId, hypothesis, howToVerify }[]
  checklist      Json // KitChecklistItem[]
  missingSources String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interview Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sections  KitSection[]
  items     KitItem[]

  @@map("interview_kits")
}

model KitSection {
  id      String           @id @default(cuid())
  kitId   String
  title   String
  minutes Int
  order   Int
  kind    GuideSectionKind

  kit   InterviewKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  items KitItem[]

  @@index([kitId])
  @@map("kit_sections")
}

model KitItem {
  id           String        @id @default(cuid())
  kitId        String
  sectionId    String
  text         String
  followUps    String[]      @default([])
  criterionIds String[]      @default([])
  anchors      Json? // { weak, medium, strong }
  required     Boolean       @default(false)
  order        Int // position inside its section
  origin       KitItemOrigin
  rationale    String?
  sourceRef    String? // 'quiz:{questionId}' | 'feedback:{feedbackId}' | 'cv:{quote}'
  edited       Boolean       @default(false)
  covered      Boolean       @default(false)
  coveredAt    DateTime?

  kit     InterviewKit  @relation(fields: [kitId], references: [id], onDelete: Cascade)
  section KitSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  notes   KitItemNote[]

  @@index([kitId])
  @@index([sectionId])
  @@map("kit_items")
}

model KitItemNote {
  id            String   @id @default(cuid())
  kitItemId     String
  participantId String
  note          String?
  score         Int? // 1-5
  evidenceQuote String?
  updatedAt     DateTime @updatedAt

  kitItem     KitItem              @relation(fields: [kitItemId], references: [id], onDelete: Cascade)
  participant InterviewParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([kitItemId, participantId])
  @@index([participantId])
  @@map("kit_item_notes")
}

// The scorecard filled by one interviewer for one interview
model InterviewerFeedback {
  id                 String    @id @default(cuid())
  interviewId        String
  interviewerId      String
  hireRecommendation String? // strong_yes | yes | maybe | no | strong_no
  notes              String?
  redFlags           String[]  @default([])
  standoutMoments    String[]  @default([])
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  interview   Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User             @relation("UserInterviewerFeedback", fields: [interviewerId], references: [id], onDelete: Cascade)
  scores      CriterionScore[]

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
  @@map("interviewer_feedback")
}

model CriterionScore {
  id          String  @id @default(cuid())
  feedbackId  String
  criterionId String
  score       Int // 1-5
  evidence    String?

  feedback  InterviewerFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  criterion ScorecardCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, criterionId])
  @@index([criterionId])
  @@map("criterion_scores")
}

model Quiz {
  id         String   @id @default(cuid())
  title      String
  positionId String
  timeLimit  Int?
  createdBy  String
  createdAt  DateTime @default(now())

  position      Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  creator       User           @relation("UserQuizzes", fields: [createdBy], references: [id], onDelete: Cascade)
  assessments   Assessment[]
  quizQuestions QuizQuestion[] // New: linked reusable questions

  @@map("quizzes")
}

// A quiz sent to a candidate (the test)
model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  candidateId   String
  quizId        String
  status        AssessmentStatus @default(pending)
  startedAt     DateTime?
  completedAt   DateTime?
  answers       Json?
  token         String           @unique
  createdAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  evaluation  Evaluation?

  @@index([applicationId])
  @@map("assessments")
}

enum AssessmentStatus {
  pending
  in_progress
  completed
  cancelled
}

// Reusable questions entity
model Question {
  id             String   @id @default(cuid())
  type           QuestionType
  question       String   // The question text
  keywords       String[] @default([])
  explanation    String?
  
  // Multiple choice fields
  options        String[] @default([])
  correctAnswer  Int?
  
  // Open question fields
  sampleAnswer   String?
  
  // Code snippet fields
  codeSnippet    String?
  sampleSolution String?
  language       String?
  
  // Favorites feature
  isFavorite     Boolean  @default(false)
  
  // Metadata
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator        User          @relation("UserQuestions", fields: [createdBy], references: [id], onDelete: Cascade)
  quizQuestions  QuizQuestion[]

  @@map("questions")
}

// Join table for Quiz-Question many-to-many relationship
model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  questionId String
  order      Int      // Order of question in the quiz
  // Ids of the scorecard criteria this question verifies in this quiz
  criterionIds String[] @default([])
  createdAt  DateTime @default(now())

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@map("quiz_questions")
}

enum QuestionType {
  multiple_choice
  open_question
  code_snippet
  behavioral_scenario
}

// AI-generated evaluations for assessments (quiz-based) and candidates (resume-based)
model Evaluation {
  id    String @id @default(cuid())
  title String // Quiz name for assessment eval, Position name for candidate eval

  // Polymorphic: one of assessmentId or candidateId will be set
  assessmentId String?    @unique // 1:1 with assessment
  candidateId String?    // Many evaluations per candidate (different positions)
  positionId  String?    // Required for candidate evaluations to track which position

  // AI evaluation content (from OverallEvaluation interface)
  evaluation     String?  // Detailed text evaluation
  strengths      String[] @default([])
  weaknesses     String[] @default([])
  recommendation String?
  fitScore       Int?     // 0-10 scale (AI's candidate fit assessment)
  quizScore      Int?     // 0-100 percentage score from quiz answers (assessment evals only)

  // Per-answer detail (assessment evals) and per-criterion assessment (CV evals)
  answerEvaluations  Json?
  criteriaAssessment Json?

  // Recruiter's manual notes ("Note manuali")
  notes String?

  // Provenance of the AI scores: model and prompt that produced them
  aiModel       String?
  promptVersion String?
  promptHash    String?

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate  Candidate?  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  creator    User        @relation("UserEvaluations", fields: [createdBy], references: [id], onDelete: Cascade)

  scoreOverrides ScoreOverride[]

  @@index([candidateId])
  @@index([positionId])
  @@map("evaluations")
}

// A person's override of an AI score, always with its reason
model ScoreOverride {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  field        String
  value        Float
  reason       String
  createdBy    String
  creator      User       @relation("ScoreOverrideCreator", fields: [createdBy], references: [id])
  createdAt    DateTime   @default(now())

  @@index([evaluationId])
  @@map("score_overrides")
}

model Preset {
  id           String   @id @default(cuid())
  name         String   @unique
  label        String
  description  String?
  icon         String   // Icon name from lucide-react
  questionType String   // multiple_choice, open_question, code_snippet, behavioral_scenario
  instructions String?
  focusAreas   String[] @default([])
  distractorComplexity String?
  expectedResponseLength ExpectedResponseLength?
  evaluationCriteria String[] @default([])
  language     String?
  bugType      String?
  codeComplexity String?
  includeComments Boolean?
  tags         String[] // e.g., ["React", "Hooks", "Advanced"]
  difficulty   Int      @default(3) // 1-5 scale
  isDefault    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("presets")
}

enum ExpectedResponseLength {
  short
  medium
  long
}

// Reference data for positions (skills, frameworks, etc.)
model ReferenceData {
  id        String   @id @default(cuid())
  category  String
  label     String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, label], map: "category_label")
  @@index([category, isActive, order])
  @@map("reference_data")
}

// MCP

enum InterviewProposalStatus {
  pending
  scheduled
  discarded
}

// An interview slot proposed through MCP: not an interview until scheduled
model InterviewProposal {
  id            String                  @id @default(cuid())
  applicationId String
  application   Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payload       Json
  status        InterviewProposalStatus @default(pending)
  createdBy     String
  creator       User                    @relation("InterviewProposalCreator", fields: [createdBy], references: [id])
  createdAt     DateTime                @default(now())
  handledAt     DateTime?
  handledBy     String?
  interviewId   String?

  @@index([applicationId, status])
  @@map("interview_proposals")
}

// One row per MCP tool call
model McpAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  clientId  String?
  scopes    String[]
  tool      String
  arguments Json
  status    String
  summary   String
  channel   String   @default("mcp")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("mcp_audit_log")
}

// Fixed-window request counters (MCP and OAuth endpoints)
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_buckets")
}

// Application-wide switches (e.g. the MCP kill switch)
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

